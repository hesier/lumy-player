--- a/ffmpeg_jni.cc
+++ b/ffmpeg_jni.cc
@@ -286,6 +286,22 @@
       outputFloat ? OUTPUT_FORMAT_PCM_FLOAT : OUTPUT_FORMAT_PCM_16BIT;
   if (extraData) {
     jsize size = env->GetArrayLength(extraData);
+    const int offset = context->codec_id == AV_CODEC_ID_COOK ? 4 : 0;
+    if (size < offset + (offset ? 8 : 0)) {
+      avcodec_free_context(&context);
+      return NULL;
+    }
