<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/chip_focused_bg" /><corners android:radius="20dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="@color/fill_strong" /><corners android:radius="20dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/fill_faint" /><corners android:radius="20dp" /></shape>
    </item>
</selector>
