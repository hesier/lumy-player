<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="96dp"
    android:paddingEnd="96dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="48dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:id="@+id/title"
            style="@style/Text.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/direct_login_hint" />

        <TextView
            android:id="@+id/phone_input"
            style="@style/Button.Lumy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/phone_input_title" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="@string/direct_login_address" />

        <EditText
            android:id="@+id/address"
            style="@style/Field.Lumy"
            android:hint="@string/direct_login_address_hint"
            android:imeOptions="actionNext|flagNoExtractUi"
            android:inputType="textUri" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="16dp"
            android:text="@string/direct_login_username" />

        <EditText
            android:id="@+id/username"
            style="@style/Field.Lumy"
            android:imeOptions="actionNext|flagNoExtractUi"
            android:inputType="text" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="16dp"
            android:text="@string/direct_login_password" />

        <EditText
            android:id="@+id/password"
            style="@style/Field.Lumy"
            android:imeOptions="actionNext|flagNoExtractUi"
            android:inputType="textPassword" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="16dp"
            android:text="@string/direct_login_name" />

        <EditText
            android:id="@+id/name"
            style="@style/Field.Lumy"
            android:hint="@string/server_name_hint"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/connect"
                style="@style/Button.Lumy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/direct_login_connect" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
