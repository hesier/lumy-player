<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- SurfaceView 渲染：4K/HDR 必须用它，TextureView 会多一次 GPU 合成 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:keep_content_on_player_reset="true"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:shutter_background_color="@android:color/black"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/hint_bg"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="@drawable/hint_bg"
        android:fontFamily="monospace"
        android:lineSpacingMultiplier="1.2"
        android:padding="14dp"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/controls_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/scrim_player_top"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingTop="@dimen/screen_padding_v"
        android:paddingEnd="@dimen/screen_padding_h"
        android:paddingBottom="64dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="24dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/Text.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/subtitle"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <TextClock
            android:id="@+id/current_time"
            style="@style/Text.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_player"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingTop="96dp"
        android:paddingEnd="@dimen/screen_padding_h"
        android:paddingBottom="28dp">

        <FrameLayout
            android:id="@+id/seek"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/seek_focus_bg"
            android:focusable="true"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ProgressBar
                android:id="@+id/seek_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_gravity="center_vertical"
                android:max="10000"
                android:progressDrawable="@drawable/seek_track" />
        </FrameLayout>

        <!-- 固定高度：拖动时出现的目标时间不能撑高这一行，否则整个进度条会往上跳 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="4dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/position"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/scrub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/remaining"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal" />

        <!-- 本季剧集：在按钮行按下键时展开，上键收起。
             用负边距铺满整行、再用 padding 对齐，外层也关掉 clipToPadding：否则首张卡片放大时左边会被外层的 padding 裁掉 -->
        <com.hesier.lumy.ui.widget.PreferredFocusRecyclerView
            android:id="@+id/episodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding_h_negative"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/screen_padding_h_negative"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding_h"
            android:paddingEnd="@dimen/screen_padding_h"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 跳过片头 / 片尾 -->
    <LinearLayout
        android:id="@+id/skip"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/screen_padding_h"
        android:layout_marginBottom="48dp"
        android:background="@drawable/button_bg"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="22dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/button_text" />

        <TextView
            android:id="@+id/skip_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:duplicateParentState="true"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/button_text"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 下一集倒计时卡片 -->
    <LinearLayout
        android:id="@+id/up_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/screen_padding_h"
        android:layout_marginBottom="40dp"
        android:background="@drawable/hint_bg"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/up_next_frame"
            android:layout_width="224dp"
            android:layout_height="126dp"
            android:background="@drawable/card_placeholder">

            <ImageView
                android:id="@+id/up_next_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/up_next_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/up_next"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/up_next_title"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/up_next_sub"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/up_next_play"
                    style="@style/Button.Lumy"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minHeight="36dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/up_next_cancel"
                    style="@style/Button.Lumy"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:minHeight="36dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/cancel" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/state"
        layout="@layout/view_state"
        android:visibility="gone" />
</FrameLayout>
