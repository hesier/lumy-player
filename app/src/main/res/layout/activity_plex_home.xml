<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_horizontal" android:padding="40dp">
    <TextView style="@style/Text.Hero" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/plex_home_title" />
    <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/plex_home_hint" />
    <ProgressBar android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="12dp" />
    <TextView android:id="@+id/status" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" />
    <com.hesier.lumy.ui.widget.PreferredFocusRecyclerView android:id="@+id/users" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:clipChildren="false" android:clipToPadding="false" android:padding="12dp" />
    <TextView android:id="@+id/retry" style="@style/Button.Lumy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/plex_home_retry" android:visibility="gone" />
</LinearLayout>
