<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="96dp"
    android:paddingTop="48dp"
    android:paddingEnd="96dp"
    android:paddingBottom="@dimen/screen_padding_v">

    <TextView
        style="@style/Text.Hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/servers_title" />

    <TextView
        android:id="@+id/status"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="560dp"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/retry"
            style="@style/Button.Lumy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/retry"
            android:visibility="gone" />

        <TextView
            android:id="@+id/other_account"
            style="@style/Button.Lumy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/servers_other_account" />
    </LinearLayout>
</LinearLayout>
