<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/panel_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="28dp">
        <TextView style="@style/Text.Title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/backup_restore" />
        <TextView android:id="@+id/summary" style="@style/Text.Body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
        <CheckBox android:id="@+id/settings" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="16dp"
            android:background="@drawable/list_item_bg" android:text="@string/backup_scope_settings"
            android:textColor="@color/text_primary" android:checked="true" />
        <CheckBox android:id="@+id/servers" android:layout_width="match_parent"
            android:layout_height="48dp" android:background="@drawable/list_item_bg"
            android:text="@string/backup_scope_servers" android:textColor="@color/text_primary"
            android:checked="true" />
        <CheckBox android:id="@+id/devices" android:layout_width="match_parent"
            android:layout_height="48dp" android:background="@drawable/list_item_bg"
            android:text="@string/backup_scope_devices" android:textColor="@color/text_primary" />
        <TextView style="@style/Text.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/backup_scope_devices_detail" />
        <TextView android:id="@+id/confirm" style="@style/Button.Lumy"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/backup_continue" />
        <TextView android:id="@+id/cancel" style="@style/Button.Lumy"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/cancel" />
    </LinearLayout>
</ScrollView>
