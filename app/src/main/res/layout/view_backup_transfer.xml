<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/panel_bg" android:orientation="vertical"
    android:gravity="center_vertical" android:padding="28dp">
    <TextView android:id="@+id/title" style="@style/Text.Title"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView style="@style/Text.Body" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:text="@string/backup_scan_hint" />
    <ImageView android:id="@+id/qr" android:layout_width="200dp"
        android:layout_height="200dp" android:layout_marginTop="20dp"
        android:background="#FFFFFF" android:importantForAccessibility="no" />
    <TextView android:id="@+id/status" style="@style/Text.Body"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />
    <TextView android:id="@+id/close" style="@style/Button.Lumy"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="@string/cancel" />
</LinearLayout>
