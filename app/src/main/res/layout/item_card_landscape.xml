<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/landscape_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/card_gap"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="@dimen/landscape_width"
        android:layout_height="@dimen/landscape_height"
        android:background="@drawable/card_placeholder"
        android:duplicateParentState="true"
        android:foreground="@drawable/focus_ring">

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <include layout="@layout/view_card_overlays" />

        <TextView
            android:id="@+id/playback_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/hint_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        style="@style/Text.CardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/subtitle"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp" />
</LinearLayout>
