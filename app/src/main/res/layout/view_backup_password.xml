<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/panel_bg" android:orientation="vertical"
    android:padding="28dp">
    <TextView android:id="@+id/title" style="@style/Text.Title"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/hint" style="@style/Text.Body"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
    <EditText android:id="@+id/password" style="@style/Field.Lumy"
        android:hint="@string/backup_password" android:inputType="textPassword"
        android:importantForAutofill="no" android:saveEnabled="false"
        android:maxLength="256" android:imeOptions="actionNext|flagNoExtractUi" />
    <EditText android:id="@+id/repeated" style="@style/Field.Lumy"
        android:hint="@string/backup_password_repeat" android:inputType="textPassword"
        android:importantForAutofill="no" android:saveEnabled="false"
        android:maxLength="256" android:imeOptions="actionDone|flagNoExtractUi" />
    <TextView android:id="@+id/error" style="@style/Text.Body"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:visibility="gone" />
    <TextView android:id="@+id/confirm" style="@style/Button.Lumy"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="@string/backup_continue" />
</LinearLayout>
