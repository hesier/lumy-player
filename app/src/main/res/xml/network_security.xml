<?xml version="1.0" encoding="utf-8"?>
<!-- 局域网里的 Plex 服务器通常是 http://192.168.x.x:32400，必须允许明文 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
